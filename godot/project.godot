; Engine configuration file.
; Metroville 3D — Godot 4.3 Native Cities: Skylines Edition

config_version=5

[application]

config/name="Metroville 3D"
config/description="Photorealistic 3D City Builder powered by Godot 4.3"
run/main_scene="res://scenes/MainCity.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/vsync/vsync_mode=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=2
environment/glow/upscale_mode=1
environment/defaults/default_clear_color=Color(0.55, 0.74, 0.92, 1)
